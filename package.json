{
  "name": "@snapshot-labs/checkpoint-template",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Checkpoint starter template",
  "scripts": {
    "codegen": "checkpoint generate",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "yarn lint --fix",
