    "extends": "@snapshot-labs"
  },
  "prettier": "@snapshot-labs/prettier-config",
  "dependencies": {
    "@snapshot-labs/checkpoint": "^0.1.0-beta.66",
    "@types/node": "^22.18.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.1",
    "express": "^4.18.1",
    "nodemon": "^2.0.19",
    "starknet": "^5.19.3",
    "ts-node": "^10.8.1",
    "typescript": "^5.9.1"
  },
  "devDependencies": {
    "@snapshot-labs/eslint-config": "^0.1.0-beta.21",
    "@snapshot-labs/prettier-config": "^0.1.0-beta.19",
    "eslint": "^8.57.1",
    "prettier": "^3.6.2"
  }
